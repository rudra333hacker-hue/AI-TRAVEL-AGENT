# ── TripCraft AI v4.0 — Configuration ──
# Copy this file to .env and fill in your keys.

## REQUIRED — At least one LLM provider key is needed.

# Google Gemini (Recommended — Free at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# NVIDIA NIM (Backup/Fallback — Free at https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=

## OPTIONAL — Enables real-time place/attraction search via Geoapify
# Sign up: https://www.geoapify.com/ (Free: 3,000 req/day)
GEOAPIFY_API_KEY=

## OPTIONAL — Server settings
HOST=0.0.0.0
PORT=8000
SESSION_TTL_MINUTES=30
